# URL da API vista pelo servidor Next (no Docker: http://api:8080)
API_INTERNAL_URL=http://localhost:5080
# Só em dev/E2E: o Next encaminha /api/* para esta URL (em produção quem faz isso é o Nginx)
API_PROXY_URL=http://localhost:5080
# NEXT_PUBLIC_* são embutidas no build: no Docker (NEXT_OUTPUT=standalone) passe-as como build args.
# O build de produção falha se faltarem. Mudar o número exige novo build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=5592995185104
# Segredo compartilhado com a API (Revalidation__Secret)
REVALIDATE_SECRET=troque-este-segredo
