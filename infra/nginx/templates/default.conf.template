server_tokens off;

# Resolve os nomes dos containers a cada 10 s (DNS interno do Docker): se api/web forem recriados
# com outro IP, o proxy acompanha sem precisar de reload.
resolver 127.0.0.11 valid=10s ipv6=off;

# O Nginx só é alcançável pelo cloudflared (porta publicada em 127.0.0.1). Os cabeçalhos da Cloudflare
# trazem o IP real do cliente e o esquema original (o TLS termina na Cloudflare).
# Sem eles (teste local), vale a conexão direta.
map $http_cf_connecting_ip $client_ip {
  ""      $remote_addr;
  default $http_cf_connecting_ip;
}
map $http_x_forwarded_proto $client_proto {
  ""      $scheme;
  default $http_x_forwarded_proto;
}

server {
  listen 80;
  server_name ${DOMAIN} localhost 127.0.0.1;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # A API aceita fotos de até 10 MB; a folga cobre o overhead do multipart.
  client_max_body_size 11m;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $client_ip;
  # Um único IP: a API usa o último da lista (ForwardLimit = 1).
  proxy_set_header X-Forwarded-For $client_ip;
  proxy_set_header X-Forwarded-Proto $client_proto;

  set $api_upstream http://api:8080;
  set $web_upstream http://web:3000;

  # Webhook interno: só a API chama, direto em web:3000.
  location = /api/revalidate { return 404; }
  location /api/   { proxy_pass $api_upstream; }
  location /media/ { proxy_pass $api_upstream; }

  location /_next/static/ {
    proxy_pass $web_upstream;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / { proxy_pass $web_upstream; }
}
