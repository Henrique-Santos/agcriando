{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Media", "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"], "Resource": "arn:aws:s3:::__MEDIA_BUCKET__/products/*" },
    { "Sid": "BackupsAndArtifacts", "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"], "Resource": ["arn:aws:s3:::__BACKUP_BUCKET__/backups/*", "arn:aws:s3:::__BACKUP_BUCKET__/artifacts/*"] },
    { "Sid": "EcrAuth", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    { "Sid": "EcrPull", "Effect": "Allow", "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"], "Resource": "arn:aws:ecr:__REGION__:__ACCOUNT__:repository/agcriando-*" },
    { "Sid": "Params", "Effect": "Allow", "Action": ["ssm:GetParametersByPath", "ssm:GetParameter", "ssm:GetParameters"], "Resource": ["arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/agcriando/prod", "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/agcriando/prod/*"] },
    { "Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"], "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/agcriando/*" },
    { "Sid": "HealthMetric", "Effect": "Allow", "Action": "cloudwatch:PutMetricData", "Resource": "*", "Condition": { "StringEquals": { "cloudwatch:namespace": "AgCriando" } } }
  ]
}
